{
  "manifest_version": 3,
  "name": "Safer",
  "version": "1.0.0",
  "description": "Local-first prompt firewall backed by a private router on this device.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "action": { "default_title": "Safer settings" }
}
